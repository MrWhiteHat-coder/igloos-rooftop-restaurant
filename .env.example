# Public (browser-exposed) Supabase project settings.
# Find both values in your Supabase dashboard: Project Settings → API → Project URL / anon public key.
# The anon key is safe for the browser ONLY because Row Level Security policies protect the data.
# NEVER put the service_role key in this file or anywhere in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
